# .env.example — Salin ke .env dan isi nilainya
# File .env TIDAK di-commit (ada di .gitignore)

# Path ke direktori yang berisi 8 file CSV dari dosen
# Contoh Windows: DATA_DIR=D:\data\maybank_clippings
# Contoh Linux:   DATA_DIR=/home/user/data/maybank_clippings
DATA_DIR=./dataset_online_news_malaysia

# Random seed untuk reproducibility
SEED=42

# Batas maksimum karakter input (judul + isi gabungan)
MAX_INPUT_CHARS=200000

# Nama / path model spaCy yang dipakai
# Pilihan: en_core_web_sm | xx_ent_wiki_sm | models/ner_finetuned
MODEL_NAME=en_core_web_sm
